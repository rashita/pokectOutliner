{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket Outliner", "version": "0.1.0", "identifier": "jp.pocketoutliner.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Pocket Outliner", "width": 620, "height": 740, "minWidth": 320, "minHeight": 280, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"], "category": "Productivity", "shortDescription": "A small plain-text outliner" }
}
